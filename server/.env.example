NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/yidianban
DATABASE_SSL=false

ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
ALIPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
ALIPAY_APP_CERT_SN=your_alipay_app_cert_sn
ALIPAY_ROOT_CERT_SN=your_alipay_root_cert_sn
ALIPAY_NOTIFY_URL=https://api.your-domain.com/api/payments/alipay/notify
ALIPAY_API_BASE_URL=https://openapi.alipay.com
ALIPAY_TRANSFER_ENABLED=false
ALIPAY_TRANSFER_MIN_AMOUNT=0.10
ALIPAY_TRANSFER_MAX_AMOUNT=5000
ALIPAY_TRANSFER_SCENE_NAME=佣金报酬
ALIPAY_TRANSFER_REPORT_INFO_TYPE=佣金报酬说明
ALIPAY_TRANSFER_REPORT_INFO_CONTENT=地陪服务报酬

PAYMENT_DEBUG_ENABLED=false
CORS_ORIGINS=https://your-domain.com,https://admin.your-domain.com

# Alibaba Cloud Mobile Push. Use a dedicated RAM user's AccessKey here.
ALIYUN_MOBILE_PUSH_ENABLED=false
ALIYUN_MOBILE_PUSH_ACCESS_KEY_ID=
ALIYUN_MOBILE_PUSH_ACCESS_KEY_SECRET=
ALIYUN_MOBILE_PUSH_CUSTOMER_APP_KEY=
ALIYUN_MOBILE_PUSH_GUIDE_APP_KEY=
ALIYUN_MOBILE_PUSH_REGION_ID=cn-hangzhou

AUTH_WHITELIST_ENABLED=false
AUTH_WHITELIST=+8613812345678:123456,+8613912345678:123456

TRTC_ENABLED=false
TRTC_SDK_APP_ID=1600000000
TRTC_SECRET_KEY=your_trtc_secret_key
TRTC_USER_SIG_EXPIRE_SECONDS=86400

# Customer travel fee: road distance is estimated from guide/customer points.
SERVICE_TRAVEL_FEE_PER_KM=1
SERVICE_ROAD_DISTANCE_MULTIPLIER=1.15
